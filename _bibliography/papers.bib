@inproceedings{zhao2026skillasapi,
  abbr={KDD-W 2026},
  title={Skill-as-API: Confidential Multi-Agent Coordination for Agentic Software Engineering},
  author={Zhao, Ziwei and Gu, Yu and Liang, Haojun and Zhang, Chen and Ding, Xizhi},
  booktitle={KDD 2026 Workshop},
  year={2026},
  abstract={A coordination layer for agentic software engineering where a skill's public view is limited to name, typed schemas, and trust tier, while the body (code and system prompt) is closure-captured and never crosses the wire. Released as an open-source Python SDK over XMTP; featured in awesome-agentic-patterns as the Black-Box Skill Invocation pattern.},
