@article{cheng2026uav,
  abbr={Drones},
  title={Uncertainty-Calibrated UAV Trajectory Prediction for Beam Management in UAV-Assisted ISAC Scenarios},
  author={Cheng, Qing and Wu, Wenwen and Zhao, Ziwei},
  journal={Drones},
  volume={10},
  number={6},
  pages={434},
  year={2026},
  publisher={MDPI},
  abstract={A multimodal trajectory-prediction framework fusing visual context (ResNet-18) and motion history (LSTM) via cross-attention and gated fusion to output calibrated probabilistic forecasts. Split conformal calibration converts raw Gaussian uncertainty into statistically reliable risk bounds, improving Coverage@95 by 7 percentage points.},
  html={https://www.mdpi.com/2504-446X/10/6/434}
}

@article{luo2025ggtpc,
  abbr={arXiv},
  title={Geometric Prior-Guided Federated Prompt Calibration},
  author={Luo, Fei and Zhao, Ziwei and Wang, Mingxuan and Li, Duoyang and Qian, Zhe and Tuo, Jiayi and Zhou, Chenyue and Ma, Yanbiao},
  journal={arXiv preprint arXiv:2512.07208},
  year={2025},
  abstract={GGTPC addresses local training bias in federated prompt learning: the server reconstructs global geometric priors from per-class statistics without exchanging raw features. As a plug-and-play module across 7 mainstream FL algorithms, it yields +9.17 pp over FedAvg on CIFAR-100 at beta=0.01 where baselines collapse.},
  arxiv={2512.07208}
}
