@article{zhao2025idi,
  abbr={PR (under review)},
  title={Information Density Imbalance in Visual Object Detection},
  author={Zhao, Ziwei and Lu, Yanxi and Hu, Yuwei and Su, Shiyang and Wang, Mingxuan and Zhou, Chenyue and Chen, Jiayi and Li, Hehan and Hao, Xiaoshuai and Zhang, Andi and Ma, Yanbiao},
  journal={Under review at Pattern Recognition},
  year={2025},
  abstract={We define categorized information density as a per-class difficulty signal beyond instance frequency. Its Pearson correlation with AP reaches about -0.72 on Pascal VOC, roughly four times stronger than the instance-count baseline, exposing a long-overlooked bias in long-tailed detector training. A local-to-global covariance merging scheme keeps global information density exact during training and reduces per-class AP variance by up to 45.89% over EFL on LVIS v1.0.},
  arxiv={2609.02369},
  selected={true}
}

@inproceedings{zhao2026scopebench,
  abbr={EMNLP 2026},
  title={ScopeBench: Evaluating Cultural Norm Scope Awareness in LLMs},
  author={Liang, Haojun and Zhao, Ziwei and Li, Chenyu and Zhao, Qiyue and Mu, Rongduomijia and Shen, Yulan and Gu, Yu and Zhang, Chen and Zhang, Kairui and Ma, Yanbiao and Wang, Wenxuan},
  booktitle={Proceedings of the 2026 Conference on Empirical Methods in Natural Language Processing (EMNLP), Main Conference},
  year={2026},
  abstract={A cultural-scope safety benchmark that treats norm scope as a first-class safety dimension. We build a dual-anchored annotation protocol across 49 countries and 9 cultural clusters (3,323 norms), define three scope error types (Inflation, Deflation, Displacement), and evaluate 21 frontier LLMs across 7 model families.},
  pdf={ScopeBench.pdf},
  selected={true}
}

